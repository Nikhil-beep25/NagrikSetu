# =============================================================================
# NagrikSetu — Production Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values.
# 3. NEVER commit your actual .env file or real API keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Server-side Only)
# -----------------------------------------------------------------------------

# Google Gemini AI API Key
# Required for live multimodal AI analysis, complaint drafting, and chat assistant.
# Obtain from: https://aistudio.google.com/
# NEVER prefix with VITE_ or expose to client bundle.
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name
# Default: gemini-3.5-flash (or gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Backend Server Port
# In production on Render/Railway, the host automatically supplies $PORT.
PORT=5001

# Allowed CORS Origins (Comma-separated)
# Leave blank or '*' during local development. In production, set to your frontend domain:
# Example: https://nagriksetu.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Client-side / Vercel Build)
# -----------------------------------------------------------------------------

# Backend API Base URL
# Leave blank during local development (Vite dev server will proxy /api to localhost:5001).
# In production on Vercel/Netlify, set this to your deployed backend origin:
# Example: https://nagriksetu-api.onrender.com
VITE_API_URL=
