# NagrikSetu - Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit .env to Git or expose GEMINI_API_KEY to the client.

# Google Gemini API Key (keep server-side only)
GEMINI_API_KEY=

# Gemini Model Selection (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash


# Backend Server Port
PORT=5001
